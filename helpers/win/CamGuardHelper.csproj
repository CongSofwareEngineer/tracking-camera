<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>camguard-helper-win</AssemblyName>
    <RootNamespace>CamGuardHelper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NativeAOT (yêu cầu MSVC C++ build tools). Nếu không có, build script dùng
         self-contained single-file (PublishSingleFile) — xem scripts/build-helper-win.ps1 -->
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
